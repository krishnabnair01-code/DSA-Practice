class RandomizedSet {
private:
    vector<int> nums;
    unordered_map<int, int> indexMap;

public:
    RandomizedSet() {}

    bool insert(int val) {
        if (indexMap.count(val))
            return false;

        nums.push_back(val);
        indexMap[val] = nums.size() - 1;
        return true;
    }

    bool remove(int val) {
        if (!indexMap.count(val))
            return false;

        int idx = indexMap[val];
        int lastVal = nums.back();

        // Move last element to idx
        nums[idx] = lastVal;
        indexMap[lastVal] = idx;

        nums.pop_back();
        indexMap.erase(val);

        return true;
    }

    int getRandom() {
        int randIndex = rand() % nums.size();
        return nums[randIndex];
    }
};
